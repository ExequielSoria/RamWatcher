RewriteEngine On

# Pasar el encabezado Authorization a PHP
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# No reescribir archivos o directorios existentes
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Todas las rutas de la API
RewriteRule ^api(?:/.*)?$ api.php [L,QSA]

# Si el ID es negativo o cero, redirigir al producto 1
RewriteRule ^(-[0-9]+|0)/?$ /1 [R=302,L]

# Web: productos por ID
RewriteRule ^([0-9]+)/?$ index.php?id=$1 [L,QSA]

# Cualquier otra URL vuelve al gráfico
RewriteRule ^ index.php [L,QSA]